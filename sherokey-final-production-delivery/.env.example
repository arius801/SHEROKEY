# =============================================================================
# SHEROKEY — Environment Configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# --- Database ----------------------------------------------------------------
# Full PostgreSQL connection string. In production this MUST point to your
# client-provided / managed production PostgreSQL instance (never localhost).
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?sslmode=require
DATABASE_URL=postgresql://user:password@your-db-host:5432/sherokey

# --- Auth / sessions -----------------------------------------------------------
# Long random string used to sign/derive session material. Generate with:
#   openssl rand -hex 32
AUTH_SECRET=replace-with-a-long-random-string

# Used to symmetrically encrypt license keys at rest (AES-256-GCM). 32+ chars.
#   openssl rand -hex 32
KEY_ENCRYPTION_SECRET=replace-with-a-long-random-string

# --- First-run admin account ---------------------------------------------------
# Used by `npm run db:seed` to create (or leave untouched if already present)
# the initial administrator account. Change the password immediately after
# first login in production.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# --- SMTP / transactional email -------------------------------------------------
# Leave SMTP_HOST blank to run in "console mode" (emails are logged to the
# server console instead of sent) — useful for local development only.
# Production MUST configure a real SMTP provider (e.g. Postmark, SES, SendGrid,
# Mailgun, or your hosting provider's SMTP relay).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=SHEROKEY
SMTP_FROM_EMAIL=no-reply@sherokey.com

# --- Payments: PayPal ------------------------------------------------------------
# Created in the PayPal Developer Dashboard for the merchant/store owner account.
# PAYPAL_MODE controls which PayPal API host is used:
#   sandbox -> https://api-m.sandbox.paypal.com  (testing only)
#   live    -> https://api-m.paypal.com           (real money)
# PayPal checkout is automatically hidden from customers unless both
# PAYPAL_CLIENT_ID and PAYPAL_CLIENT_SECRET are set.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# --- Payments: Card (Stripe) ------------------------------------------------------
# Stripe Checkout is used for card payments (Visa/Mastercard/etc. as enabled on
# your Stripe account). Raw card data never touches the SHEROKEY server/database.
# Card checkout is automatically hidden from customers unless STRIPE_SECRET_KEY
# is set. STRIPE_WEBHOOK_SECRET is required to verify webhook authenticity —
# orders are only ever marked PAID after a verified webhook event.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Site -------------------------------------------------------------------------
# Public, fully-qualified base URL of the deployed site (used for payment
# redirect/callback URLs, emails, sitemap, canonical URLs, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
