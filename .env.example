# --- Database -----------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- Auth / sessions ------------------------------------------------------
AUTH_SECRET=replace-with-a-long-random-string
# Used to symmetrically encrypt license keys at rest (32+ chars recommended)
KEY_ENCRYPTION_SECRET=replace-with-a-long-random-string

# --- First-run admin account ---------------------------------------------
# Used by `npm run db:seed` to create/update the initial administrator.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# --- SMTP / transactional email -------------------------------------------
# Leave blank to run in "console mode" (emails are logged, not sent).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=SHEROKEY
SMTP_FROM_EMAIL=no-reply@sherokey.com

# --- Payments ---------------------------------------------------------
# Providers are only enabled on checkout when their credentials are present.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Misc -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
